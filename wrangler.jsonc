{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-wish-list",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-01",
  // fetch()を常に公開インターネット経由にする。OAuthのCIMD(クライアントが指定したURLの文書)を取りに行くとき、
  // 同じゾーンや非公開の宛先へ抜けるSSRFを防ぐため
  "compatibility_flags": ["global_fetch_strictly_public"],
  // workers.devとPreview URLはCloudflare Accessで保護されないため無効化する
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-wish-list-db",
      "database_id": "7be0bcb7-6078-4659-b7c4-055e4059e9af",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [
    {
      "pattern": "wish-list.example.com",
      "custom_domain": true
    }
  ],
  // 誰でも呼べる /oauth/register(DCR)の濫用でD1の無料枠を食い潰されないよう、IPごとに回数を制限する
  "ratelimits": [
    {
      "name": "REGISTER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // エージェント接続まわりの期限切れの行を毎日消す(src/index.tsx の scheduled)
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": {
    "enabled": true
  },
  // routesのpatternとCF_ACCESS_TEAM_DOMAINはプレースホルダー。本番の値はGitHub Actions(ci.yml)が
  // デプロイ直前にGitHub Secretsから差し込む。そのためローカルから直接 wrangler deploy しないこと。
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    // CloudFlare AccessでこのアプリのApplicationを作成した後、発行されたAUDタグをここに設定する。
    "CF_ACCESS_AUD": "20bef9e2f97cd137f001a2f7650b18dc0a88e8d41c80be5c60f732bd4aff37e7",
    // ローカル開発時(CF_ACCESS_AUD未設定時)に使うユーザーメールアドレス。本番では必ず空にする。
    // 空の間はAccess未設定でも誰も認証されない。ローカルでは .dev.vars で上書きする。
    "DEV_USER_EMAIL": ""
  }
}
