{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-wish-list",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-wish-list-db",
      "database_id": "7be0bcb7-6078-4659-b7c4-055e4059e9af",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [
    {
      "pattern": "wish-list.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    // CloudFlare AccessでこのアプリのApplicationを作成した後、発行されたAUDタグをここに設定する。
    "CF_ACCESS_AUD": "",
    // ローカル開発時(CF_ACCESS_AUD未設定時)に使うユーザーメールアドレス。本番では使用しない。
    "DEV_USER_EMAIL": ""
  }
}
