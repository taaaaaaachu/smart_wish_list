{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-wish-list",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-wish-list-db",
      "database_id": "7be0bcb7-6078-4659-b7c4-055e4059e9af",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
